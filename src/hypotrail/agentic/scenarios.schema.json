{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chadlis/hypotrail/src/hypotrail/agentic/scenarios.schema.json",
  "title": "scenarios file of the scripted_fixture Mode",
  "description": "The whole shape of the technical scenarios a Workload names with `scenarios`. A script is a list of model turns, each one a tool call, an answer built from the last tool result, or a raw answer. A scenario whose script is null is expected but never run. References are not checked here: the Scorer judges them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "scenarios"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["scenarios/1"]},
    "mode": {"type": "string", "enum": ["scripted_fixture"]},
    "description": {"type": "string"},
    "scenarios": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scenario"}}
  },
  "$defs": {
    "name": {"type": "string", "minLength": 1},
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "case", "script"],
      "properties": {
        "scenario_id": {"$ref": "#/$defs/name"},
        "case": {
          "type": "object",
          "additionalProperties": false,
          "required": ["case_id", "question", "answer_columns", "unit"],
          "properties": {
            "case_id": {"$ref": "#/$defs/name"},
            "question": {"$ref": "#/$defs/name"},
            "answer_columns": {"type": "array", "items": {"type": "string"}},
            "unit": {"$ref": "#/$defs/name"}
          }
        },
        "reference": {"type": "object"},
        "script": {"type": ["array", "null"], "minItems": 1, "items": {"$ref": "#/$defs/turn"}}
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool_call": {
          "type": "object",
          "additionalProperties": false,
          "required": ["function", "arguments"],
          "properties": {"function": {"$ref": "#/$defs/name"}, "arguments": {"type": "object"}}
        },
        "repeat": {"type": "boolean"},
        "answer_from_last_result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit"],
          "properties": {
            "unit": {"type": ["string", "null"]},
            "status": {"type": "string"},
            "reason_code": {"type": ["string", "null"]},
            "columns": {"type": "array"},
            "rows": {"type": "array"},
            "evidence": {"type": "array"}
          }
        },
        "raw_answer": {"type": "string"}
      },
      "oneOf": [
        {"required": ["tool_call"], "not": {"anyOf": [{"required": ["answer_from_last_result"]}, {"required": ["raw_answer"]}]}},
        {"required": ["answer_from_last_result"], "not": {"anyOf": [{"required": ["tool_call"]}, {"required": ["raw_answer"]}, {"required": ["repeat"]}]}},
        {"required": ["raw_answer"], "not": {"anyOf": [{"required": ["tool_call"]}, {"required": ["answer_from_last_result"]}, {"required": ["repeat"]}]}}
      ]
    }
  }
}
