{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chadlis/hypotrail/src/hypotrail/core/data-manifest.schema.json",
  "title": "data-manifest.json of a Workload whose data lives outside the repository",
  "description": "data-manifest/1. Each source is declared by its digest and size, with its licence notice; there is no URL and no local path, so `data fetch` has nothing to fetch and `data verify` reports the source `declared` and opens no data file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {"const": "data-manifest/1"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dataset_id", "sha256", "size_bytes", "as_of", "license", "notice", "notice_sha256"],
        "properties": {
          "dataset_id": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "as_of": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "license": {"type": "string", "minLength": 1},
          "notice": {"type": "string", "minLength": 1},
          "notice_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
