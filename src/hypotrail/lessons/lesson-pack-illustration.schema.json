{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "An optional lesson-pack/2 teaching illustration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "layout",
    "labels",
    "caption"
  ],
  "properties": {
    "layout": {
      "enum": [
        "flow",
        "compare"
      ]
    },
    "labels": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[^<>\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]+$(?![\\s\\S])"
      }
    },
    "caption": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[^<>\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]+$(?![\\s\\S])"
    }
  },
  "if": {
    "properties": {
      "layout": {
        "const": "compare"
      }
    }
  },
  "then": {
    "properties": {
      "labels": {
        "maxItems": 2
      }
    }
  }
}
