{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chadlis/hypotrail/src/hypotrail/ml/contracts/ml-scores-1/scores.schema.json",
  "title": "ml-scores/1: scores.csv, as a table",
  "type": "object",
  "required": ["columns", "rows"],
  "properties": {
    "columns": {"const": ["item_id", "score"]},
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "score"],
        "properties": {
          "item_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+@[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "score": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"}
        }
      }
    }
  }
}
