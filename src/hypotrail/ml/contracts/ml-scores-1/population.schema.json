{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chadlis/hypotrail/src/hypotrail/ml/contracts/ml-scores-1/population.schema.json",
  "title": "ml-scores/1: population.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["item_ids"],
  "properties": {
    "item_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]+@[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
    }
  }
}
