  "evidence_phrases": ["result_changed=result changed", "evidence_rescored=evidence rescored", "repeated=repeated, nothing changed"],
  "applies_phrases": ["true=applies", "false=does not apply"],
  "no_value": "no value",
  "withheld": "withheld",
  "messages": ["read-again", "record", "send-again", "open"],
  "open_refs": ["per_item", "paired_deltas", "population", "record"],
  "decide_author": "human",
  "guard_bounds": ["width=420", "question=200", "evidence=350"],
  "colour_forms": ["hexadecimal", "rgb()", "rgba()", "hsl()", "hsla()", "hwb()", "lab()", "lch()", "oklab()", "oklch()", "color()", "color-mix()", "named"],
  "number_links": ["write_sequence=study", "value=assessment", "delta=comparison", "control=comparison", "candidate=comparison", "coverage=comparison", "cited=assessment", "latest=assessment", "changed_item_count=assessment", "pending_decisions=study", "warnings=warnings", "limitations=limitations", "bin_count=comparison", "bin_edge=comparison", "quartile=comparison", "dot_end=comparison", "writes_since=since", "interval=comparison", "item_counts=assessment"],
  "statuses": ["status", "comparability.status", "applies", "withdrawn"],
