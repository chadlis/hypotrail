{
  "program": "uv",
  "first_arguments": ["run", "--no-sync", "python", "-m", "hypotrail"],
  "read_arguments": ["status", "--study={path}", "--json"],
  "figures_arguments": ["figures", "--study={path}", "--json"],
  "reads": ["status", "figures"],
  "writes": ["decide"],
  "decide_options": ["--study", "--question", "--option", "--author", "--source", "--artifact", "--request-id", "--read-sequence", "--json"],
  "decide_optional_options": ["--source"],
  "read_timeout_ms": 30000,
  "write_timeout_ms": 120000,
  "max_buffer_bytes": 16777216,
  "outcomes": ["success", "refusal", "no_answer", "client_refusal"],
  "no_answer_causes": ["not_started", "timeout", "too_large", "no_json", "inconsistent"],
  "write_no_answer_words": "outcome unknown",
  "client_refusal_fields": ["question", "option", "author", "cited_ids", "source", "request_id", "read_sequence"],
  "walk_depth": 2,
  "walk_max_folders": 500,
  "walk_skipped": ["node_modules", ".venv", ".*"],
  "no_study_message": "No Hypotrail Study was found in this workspace.",
  "panel_options": ["enableScripts=true", "enableCommandUris=false", "enableForms=false", "localResourceRoots=[]"],
  "csp_directives": [
    "default-src 'none'",
    "style-src 'nonce-{nonce}'",
    "script-src 'nonce-{nonce}'",
    "img-src 'none'",
    "font-src 'none'",
    "connect-src 'none'",
    "frame-src 'none'",
    "form-action 'none'",
    "base-uri 'none'"
  ],
  "link_forms": [
    "vscode://hypotrail-local.hypotrail/study?study={path}",
    "vscode://hypotrail-local.hypotrail/decision/{uuid}?study={path}"
  ],
  "link_decision_id": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
  "link_max_path": 4096,
  "link_refusal": "This Hypotrail link is not valid.",
  "labels": [
    "Reading the Study.",
    "Read again",
    "Study",
    "Write sequence",
    "Pending decisions",
    "No pending decision.",
    "Comparison",
    "Delta",
    "Coverage",
    "Control",
    "Candidate",
    "Assessment",
    "Metric",
    "status",
    "Warnings of the Comparison",
    "Limitations of the Comparison",
    "Decisions",
    "Declared deviations",
    "withdrawn",
    "No answer from the CLI:",
    "Author",
    "Cited ids",
    "applies",
    "Reasons",
    "Changed Items",
    "Cited value",
    "Latest value",
    "Opened from a link",
    "This Study holds no Decision with the id",
    "Send again",
    "Record this Decision",
    "Recording the Decision.",
    "Nothing was sent. Missing:",
    "The Decision was recorded.",
    "Output path",
    "comparability.status",
    "Recorded:",
    "The Decision may have been recorded.",
    "Send again: a Decision already recorded is not written twice.",
    "The Study was read again; choose again.",
    "Number of pending decisions:",
    "To the choices",
    "Sent:",
    "Failed:",
    "None.",
    "Figures unavailable. Read again.",
    "No figure for this Comparison:",
    "Paired deltas",
    "Items per bin of paired delta",
    "Minimum",
    "First quartile",
    "Median",
    "Third quartile",
    "Maximum",
    "Values of the Control and the Candidate",
    "Cases per bin of paired delta",
    "Absolute error per Item",
    "Zero",
    "Items below",
    "Cases below"
  ],
  "evidence_phrases": ["result_changed=result changed", "evidence_rescored=evidence rescored", "repeated=repeated, nothing changed"],
  "applies_phrases": ["true=applies", "false=does not apply"],
  "no_value": "no value",
  "withheld": "withheld",
  "messages": ["read-again", "record", "send-again"],
  "decide_author": "human",
  "guard_bounds": ["width=420", "question=200", "evidence=350"],
  "colour_forms": ["hexadecimal", "rgb()", "rgba()", "hsl()", "hsla()", "hwb()", "lab()", "lch()", "oklab()", "oklch()", "color()", "color-mix()", "named"],
  "number_links": ["write_sequence=study", "value=assessment", "delta=comparison", "control=comparison", "candidate=comparison", "coverage=comparison", "cited=assessment", "latest=assessment", "changed_item_count=assessment", "pending_decisions=study", "warnings=warnings", "limitations=limitations", "bin_count=comparison", "bin_edge=comparison", "quartile=comparison", "dot_end=comparison"],
  "statuses": ["status", "comparability.status", "applies", "withdrawn"],
  "key_paths": [
    "assessments[].assessment_id",
    "assessments[].metrics[].id",
    "assessments[].metrics[].status",
    "assessments[].metrics[].unit",
    "assessments[].metrics[].value",
    "assessments[].per_item_ref.path",
    "comparisons[].comparability.status",
    "comparisons[].comparison_id",
    "comparisons[].coverage.*",
    "comparisons[].delta.candidate",
    "comparisons[].delta.control",
    "comparisons[].delta.definition",
    "comparisons[].delta.metric",
    "comparisons[].delta.unit",
    "comparisons[].delta.value",
    "comparisons[].limitations",
    "comparisons[].paired_deltas_ref.path",
    "comparisons[].population_ref.path",
    "comparisons[].roles.candidate_assessment_id",
    "comparisons[].roles.control_assessment_id",
    "comparisons[].warnings[].code",
    "comparisons[].warnings[].message",
    "decisions[].applies",
    "decisions[].author",
    "decisions[].cited_ids",
    "decisions[].decision_id",
    "decisions[].evidence_change.lines[].assessment_id",
    "decisions[].evidence_change.lines[].changed_item_count",
    "decisions[].evidence_change.lines[].latest_assessment_id",
    "decisions[].evidence_change.lines[].metrics[].cited",
    "decisions[].evidence_change.lines[].metrics[].id",
    "decisions[].evidence_change.lines[].metrics[].latest",
    "decisions[].evidence_change.lines[].state",
    "decisions[].evidence_change.state",
    "decisions[].option",
    "decisions[].question",
    "decisions[].reasons[].id",
    "decisions[].reasons[].reason",
    "declared_deviations[].declared_deviation_id",
    "declared_deviations[].withdrawn",
    "pending_decisions[].candidate_assessment_id",
    "pending_decisions[].comparison_id",
    "pending_decisions[].control_assessment_id",
    "pending_decisions[].options[].consequence",
    "pending_decisions[].options[].text",
    "pending_decisions[].question.text",
    "study.study_id",
    "write_sequence"
  ],
  "figures_key_paths": [
    "comparisons[].comparison_id",
    "comparisons[].histogram[].count",
    "comparisons[].histogram[].high",
    "comparisons[].histogram[].low",
    "comparisons[].paired_deltas[].candidate_abs_error",
    "comparisons[].paired_deltas[].candidate_share",
    "comparisons[].paired_deltas[].case_id",
    "comparisons[].paired_deltas[].control_abs_error",
    "comparisons[].paired_deltas[].control_share",
    "comparisons[].paired_deltas[].delta_abs_error",
    "comparisons[].paired_deltas[].delta_share",
    "comparisons[].paired_deltas[].row_id",
    "comparisons[].quartiles.max",
    "comparisons[].quartiles.median",
    "comparisons[].quartiles.min",
    "comparisons[].quartiles.q1",
    "comparisons[].quartiles.q3",
    "comparisons[].unavailable",
    "write_sequence"
  ]
}
